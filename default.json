{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchCurrentVersion": "/(^0\\.|-.+$)/",
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "discord-py-self"
      ],
      "automerge": false
    },
    {
      "description": "Pin uv application requirements so artifact resolution cannot jump ahead of the minimum release age.",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "requires-python declares supported interpreters; changing its minimum is a compatibility change, not an installed runtime update. Docker images and actual interpreter pins remain updated.",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    },
    {
      "description": "Update Go module requirements and Docker compiler images together.",
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "Go toolchain",
      "separateMajorMinor": false
    },
    {
      "description": "Poetry build backends are isolated PEP 517 requirements, not dependencies installed from poetry.lock.",
      "matchManagers": [
        "poetry"
      ],
      "matchDepTypes": [
        "build-system.requires"
      ],
      "matchPackageNames": [
        "poetry-core"
      ],
      "skipArtifactsUpdate": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/\\.github/workflows/.*\\.ya?ml$/",
        "/cranes/.*/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:ARG [A-Z_]+=|version: |POETRY_VERSION: |TRIVY_VERSION: )(?<currentValue>[^\\s]+)"
      ]
    }
  ]
}
